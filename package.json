{
  "name": "webhook-hub",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsup",
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts",
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "generate:tq-contract": "openapi-zod-client \"https://raw.githubusercontent.com/fohte/tq/${TQ_SPEC_REF:-main}/openapi.json\" -o src/plugins/tq/generated/tq-contract.ts -t src/plugins/tq/tq-contract.template.hbs --export-schemas",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fohte/service-kit": "0.1.16",
    "@hono/node-server": "2.0.12",
    "@octokit/webhooks": "14.2.0",
    "@octokit/webhooks-types": "7.6.1",
    "@opentelemetry/api": "1.9.1",
    "@slack/web-api": "7.16.0",
    "hono": "4.12.34",
    "neverthrow": "8.2.0",
    "pino": "10.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@fohte/eslint-config": "0.5.1",
    "@ninoseki/eslint-plugin-neverthrow": "0.3.1",
    "@slack/types": "2.22.0",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.6",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "knip": "6.37.0",
    "openapi-zod-client": "1.18.3",
    "prettier": "3.9.8",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
